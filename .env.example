# =============================================================================
# CivicNexus BRICS - Environment Variables Template
# =============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# Database Connection (MySQL / TiDB)
DATABASE_URL=mysql://user:password@localhost:3306/civicnexus

# Google Gemini / Vertex AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Forge / LLM Proxy
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# Authentication & Session Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
OAUTH_SERVER_URL=https://api.example.com
VITE_APP_ID=civicnexus-brics-app
OWNER_OPEN_ID=admin_open_id

# Messaging Gateway Webhook Token (WhatsApp / Telegram / Gov Gateway)
CIVIC_MESSAGE_WEBHOOK_TOKEN=your_secure_webhook_token_here

# Frontend Configuration
VITE_APP_TITLE="CivicNexus BRICS"
VITE_OAUTH_PORTAL_URL=https://auth.example.com
